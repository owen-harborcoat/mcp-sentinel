# Local credentials only; never commit .env or token files.
# Wasmer SDK runs locally without an API key. Reserved for future cloud integration.
WASMER_API_KEY=dummy-wasmer-key
# Node 24+ executable; set an absolute path if your default Node is older.
WASMER_NODE=node
GEMINI_API_KEY=dummy-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Free bot notifications, opt-in after preview verification.
TELEGRAM_BOT_TOKEN=dummy-telegram-token
TELEGRAM_CHAT_ID=
# Optional SMS adapter. Current Twilio trial does not support custom alert text.
TWILIO_ACCOUNT_SID=dummy-twilio-account
TWILIO_API_KEY_SID=dummy-twilio-api-key
TWILIO_API_KEY_SECRET=dummy-twilio-secret
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_CUSTOM_SMS_ENABLED=0
LIVE_NOTIFICATIONS=0
SQLITE_PATH=sentinel/sentinel.db
